# 复制为deploy/.env.production并chmod 600；真实值不得提交。
# password使用随机十六进制，避免URL转义歧义。
POSTGRES_PASSWORD=
SERVICE_AUTH_TOKEN=
AUTH_TOKEN_PEPPER=
AUTH_CSRF_SECRET=
PUBLIC_HOST=career.example.com
AUTH_PUBLIC_ORIGIN=https://career.example.com
AUTH_TRUSTED_PROXIES=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
CAREER_IMAGE=career-assistant:local
CAREER_WEB_IMAGE=career-assistant-web:local
HTTP_PORT=80
HTTPS_PORT=443
NODE_ENV=production
# 使用compose.server.yml的已授权采集部署必须配置独立预算，不能清零历史用量。
INGESTION_BUDGET_ID=
INGESTION_REQUEST_LIMIT=0
INGESTION_OPERATOR_REFERENCE=
# 运维命令：CAREER_COMPOSE_OVERRIDE=deploy/compose.server.yml sh deploy/compose.sh ps
# 备份/恢复也必须带同一CAREER_COMPOSE_OVERRIDE；来源凭据另存deploy/.env.source，0600。
