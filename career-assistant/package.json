{
  "name": "career-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build": "pnpm run build:packages && pnpm -r --filter './apps/*' build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts tests *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:interfaces": "node scripts/check-interfaces.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/run-database-tests.mjs integration",
    "test:e2e": "node scripts/run-database-tests.mjs e2e",
    "test:verification": "npm --prefix tools/verification test",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy --config prisma.config.ts",
    "dev:api": "node scripts/with-env.mjs node apps/api/dist/main.js",
    "dev:agent": "node scripts/with-env.mjs node apps/agent/dist/main.js",
    "dev:worker": "node scripts/with-env.mjs node apps/worker/dist/main.js",
    "dev:web": "node scripts/with-env.mjs pnpm --filter @career/web dev",
    "check": "node scripts/verify.mjs",
    "check:maintenance": "node scripts/check-maintenance.mjs",
    "test:deployment": "node scripts/verify-deployment.mjs",
    "dev": "node scripts/run-local.mjs"
  },
  "devDependencies": {
    "@career/agent-core": "workspace:*",
    "@career/business": "workspace:*",
    "@career/config": "workspace:*",
    "@career/contracts": "workspace:*",
    "@career/observability": "workspace:*",
    "@career/testing": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
