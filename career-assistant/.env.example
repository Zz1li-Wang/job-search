# 复制为.env，填写本地值。不要提交.env。
DATABASE_URL=postgresql://career:replace_local_password@127.0.0.1:55432/career
POSTGRES_PASSWORD=replace_local_password
POSTGRES_PORT=55432
SERVICE_AUTH_TOKEN=replace_with_random_value_at_least_32_characters
API_PORT=3001
AGENT_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:3001
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
MODEL_API_KEY=
PRIVATE_FILE_ROOT=./var/private
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_TOKEN_PEPPER=replace_with_an_independent_random_secret
AUTH_CSRF_SECRET=replace_with_another_independent_random_secret
AUTH_TRUSTED_PROXIES=

# 采集默认关闭；第六步验证最多40次，持续运行额度需另行确认。
INGESTION_NETWORK_ENABLED=false
INGESTION_BUDGET_ID=step6-approved-verification
INGESTION_REQUEST_LIMIT=40
INGESTION_COOKIE_FILE=tools/verification/.env.source
INGESTION_OPERATOR_REFERENCE=
INGESTION_EXPORT_ROOT=./var/exports
